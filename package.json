{
  "name": "facebook-clean-my-feeds",
  "version": "6.3.2",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "check:node": "node --import tsx tools/check-node.ts",
    "lint": "eslint --no-eslintrc --config tools/config/eslint.json --ext .ts src tools tests --max-warnings 0",
    "format": "prettier --config tools/config/prettier.json --write .",
    "format:check": "prettier --config tools/config/prettier.json --check .",
    "build": "node --import tsx tools/build.ts",
    "icons:optimize": "node --import tsx tools/optimize-icons.ts",
    "release": "semantic-release",
    "test": "jest --config tools/config/jest.json --runInBand",
    "typecheck:browser": "tsc --project tsconfig.browser.json",
    "typecheck:core": "tsc --project tsconfig.core.json",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "typecheck": "npm run typecheck:browser && npm run typecheck:core && npm run typecheck:tools && npm run typecheck:tests",
    "check:locales": "node --import tsx tools/check-locales.ts",
    "check:governance": "node --import tsx tools/governance/check.ts",
    "check:artifact": "node --import tsx tools/verify-artifact.ts",
    "verify": "npm run check:node && npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:locales && npm run check:governance && npm run build && npm run check:artifact"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "esbuild": "0.27.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "fake-indexeddb": "6.2.5",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.7.4",
    "semantic-release": "25.0.2",
    "sharp": "0.34.5",
    "ts-jest": "29.4.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "license": "GPL-3.0-only"
}
